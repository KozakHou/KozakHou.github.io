<header class="ed-nav">
  <div class="ed-nav-inner">
    <a class="ed-brand" href="{{ '/' | relative_url }}">
      <span>Kozak Hou</span>
      <small>侯博瀚 · Numeric/Modelling/Fusion/SciML</small>
    </a>
    <nav class="ed-navlinks" aria-label="Primary navigation">
      <a href="{{ '/' | relative_url }}" {% if page.ed_active == 'about' %}class="active" aria-current="page"{% endif %}>About</a>
      <a href="{{ '/projects/' | relative_url }}" {% if page.ed_active == 'research' %}class="active" aria-current="page"{% endif %}>Research</a>
      <a href="{{ '/consulting/' | relative_url }}" {% if page.ed_active == 'consulting' %}class="active" aria-current="page"{% endif %}>Consulting</a>
      <a href="{{ '/publications/' | relative_url }}" {% if page.ed_active == 'publications' %}class="active" aria-current="page"{% endif %}>Papers</a>
      <a href="{{ '/CV/' | relative_url }}" {% if page.ed_active == 'cv' %}class="active" aria-current="page"{% endif %}>CV</a>
      {% if site.enable_darkmode %}
        <button id="light-toggle" class="ed-theme-toggle" title="Change theme" aria-label="Toggle theme">
          <i class="ti ti-sun-moon" id="light-toggle-system"></i>
          <i class="ti ti-moon-filled" id="light-toggle-dark"></i>
          <i class="ti ti-sun-filled" id="light-toggle-light"></i>
        </button>
      {% endif %}
    </nav>
  </div>
</header>
